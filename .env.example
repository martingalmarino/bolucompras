# URL pública, sin barra final. Canonical, Open Graph, sitemap, JSON-LD y /rss.xml salen de acá.
# En producción: https://www.nolonecesitas.com.ar
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta google-site-verification. Si está vacía, el tag no se imprime.
# El código que ya diste Search Console: crGNhcUvRZASWLc8ANndk83KMX8Q1U6kLfaZ4w9BPtk
NEXT_PUBLIC_GSC_VERIFICATION=

# Si está, /api/revalidate exige Authorization: Bearer <este valor>.
CRON_SECRET=

# Kit (ConvertKit), API v3. Solo se leen en el servidor. No uses el prefijo NEXT_PUBLIC_.
KIT_API_KEY=
KIT_FORM_ID=
