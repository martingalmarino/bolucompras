# URL pública, sin barra al final. Canonical, sitemap, Open Graph y el feed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Si está, /api/revalidate exige Authorization: Bearer <este valor>.
CRON_SECRET=

# Kit (ConvertKit), API v3. Solo se leen en el servidor. No uses el prefijo NEXT_PUBLIC_.
KIT_API_KEY=
KIT_FORM_ID=
